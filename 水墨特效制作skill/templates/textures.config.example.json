    ["slash-wide", "vfx-slash-arc-wide", "front", "01", 1],
    ["line", "vfx-slash-line", "front", "01", 1],
    ["splat", "vfx-ink-splat", "seq", "01", 4],
    ["burst", "vfx-ink-burst-ring", "front", "01", 1],
    ["shockwave", "vfx-shockwave-ring", "front", "01", 1],
    ["fan", "vfx-telegraph-fan", "front", "01", 1],
    ["ring", "vfx-telegraph-ring", "front", "01", 1],
    ["noise", "vfx-noise-ink", "tile", "01", 1],
    ["mist", "vfx-mist-wisp", "sheet", "01", 2],
    ["spark", "vfx-spark", "sheet", "01", 2]
